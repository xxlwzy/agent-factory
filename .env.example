# LiteLLM proxy (see ../litellm-proxy/agent-env.example)
LITELLM_PROXY_BASE_URL=http://127.0.0.1:4000/v1
LITELLM_PROXY_API_KEY=sk-local

# Recommended primary model (uncomment to pin; otherwise first entry in default priority)
# OPENAI_MODEL=mimo/mimo-v2.5-pro

# Optional: custom comma-separated fallback order
# LITELLM_MODEL_PRIORITY=mimo/mimo-v2.5-pro,mimo/mimo-v2.5,ms/deepseek-v4,onehub/qwen3.6-plus

# Default when unset: MiMo → ModelScope (ms/) → OneHub (see llm/model_priority.py)
